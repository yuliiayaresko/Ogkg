<Window x:Class="ClosestPoints.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Найближча пара A-B | O(N log N)" Height="700" Width="1100">
    <Grid Background="#1a1a1a">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Main controls -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#222"
                    Height="52" VerticalAlignment="Center">

            <!-- Mode radio buttons -->
            <Border BorderBrush="#444" BorderThickness="0,0,1,0" Margin="4,0,4,0" Padding="4,0">
                <StackPanel VerticalAlignment="Center">
                    <RadioButton Name="RbDemo" Content="Демо (≤100)" Foreground="White"
                                 IsChecked="True" Checked="ModeDemo_Checked"
                                 FontSize="11" Margin="2,1"/>
                    <RadioButton Name="RbAuto" Content="Авто (≤10 000)" Foreground="White"
                                 Checked="ModeAuto_Checked"
                                 FontSize="11" Margin="2,1"/>
                </StackPanel>
            </Border>

            <!-- Point count + generate -->
            <TextBlock Text="Кількість:" Foreground="#aaa" VerticalAlignment="Center" Margin="8,0,4,0" FontSize="12"/>
            <TextBox Name="PointsCountBox" Text="10000" Width="68" Height="26"
                     VerticalContentAlignment="Center" Margin="0,0,6,0"
                     Background="#333" Foreground="White" BorderBrush="#555"/>

            <Button Content="Генерувати" Width="90" Height="30" Margin="3"
                    Click="Generate_Click" Background="#335" Foreground="White"/>
            <Button Content="Найгірший ввід" Width="110" Height="30" Margin="3"
                    Click="WorstCase_Click" Background="#353" Foreground="White"
                    ToolTip="Генерує точки поруч із роздільною прямою — максимальне навантаження на фазу смуги"/>
            <Button Content="Benchmark" Width="85" Height="30" Margin="3"
                    Click="Benchmark_Click" Background="#433" Foreground="White"
                    ToolTip="Порівняє час для N=500…30000 і покаже константу O(N log N)"/>

            <Separator Width="1" Background="#444" Margin="4,6"/>

            <!-- Set selector (demo mode) -->
            <TextBlock Text="Множина (демо):" Foreground="#aaa" VerticalAlignment="Center"
                       Margin="6,0,4,0" FontSize="12"/>
            <ComboBox Name="ModeBox" Width="52" Height="26" VerticalContentAlignment="Center"
                      Background="#333" Foreground="White">
                <ComboBoxItem Content="A" IsSelected="True"/>
                <ComboBoxItem Content="B"/>
            </ComboBox>

            <Separator Width="1" Background="#444" Margin="6,6"/>

            <Button Content="Знайти пару" Width="100" Height="30" Margin="4"
                    Click="FindClosest_Click" FontWeight="Bold"
                    Background="#224422" Foreground="White"/>
            <Button Content="Очистити" Width="80" Height="30" Margin="4"
                    Click="Clear_Click" Background="#442222" Foreground="White"/>
        </StackPanel>

        <!-- Row 1: Status bar -->
        <Grid Grid.Row="1" Background="#1e1e1e" Height="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="ResultText" Grid.Column="0" Foreground="Gold"
                       VerticalAlignment="Center" Margin="12,0"
                       FontSize="13" FontWeight="SemiBold"/>
            <TextBlock Name="ModeLabel" Grid.Column="1" Foreground="#888"
                       VerticalAlignment="Center" Margin="12,0"
                       FontSize="11" Text="Режим: Демо — ручний ввід мишею (≤100 точок)"/>
        </Grid>

        <!-- Row 2: Canvas + bottom counter -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="22"/>
            </Grid.RowDefinitions>
            <Canvas Grid.Row="0" Name="MyCanvas" Background="#111"
                    MouseLeftButtonDown="Canvas_Click"
                    ClipToBounds="True" Loaded="MyCanvas_Loaded"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Background="#1a1a1a">
                <TextBlock Name="CountLabel" Foreground="#666" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0"
                           Text="A: 0   B: 0   Разом: 0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
