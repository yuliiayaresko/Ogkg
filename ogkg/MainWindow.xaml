<Window x:Class="ClosestPoints.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Closest Pair A-B (O(N log N))" Height="650" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#222" VerticalAlignment="Center" Height="60">
            <TextBlock Text="Кількість:" Foreground="White" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <TextBox Name="PointsCountBox" Text="10000" Width="70" Height="25" VerticalContentAlignment="Center" Margin="0,0,10,0"/>

            <Button Content="Генерувати" Width="90" Height="30" Margin="5" Click="Generate_Click"/>
            <Button Content="Очистити" Width="80" Height="30" Margin="5" Click="Clear_Click" Background="#442222" Foreground="White"/>
            <Button Content="Знайти пару" Width="100" Height="30" Margin="5" Click="FindClosest_Click" FontWeight="Bold" Background="#224422" Foreground="White"/>

            <TextBlock Text="Множина:" Foreground="White" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <ComboBox Name="ModeBox" Width="50" Height="25" VerticalContentAlignment="Center">
                <ComboBoxItem Content="A" IsSelected="True"/>
                <ComboBoxItem Content="B"/>
            </ComboBox>

            <TextBlock Name="ResultText" Foreground="Gold" VerticalAlignment="Center" Margin="20,0" FontWeight="SemiBold" FontSize="14"/>
        </StackPanel>

        <Canvas Grid.Row="1" Name="MyCanvas" Background="#111" MouseLeftButtonDown="Canvas_Click" ClipToBounds="True"/>
    </Grid>
</Window>